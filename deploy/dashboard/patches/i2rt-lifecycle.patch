+                    raise RuntimeError("Motor worker cannot close itself")
+                if worker.is_alive():
+                    worker.join(timeout=2.0)
+                if worker.is_alive():
+                    raise RuntimeError("Motor worker did not stop; refusing concurrent disable")
+            if not disable_motors:
