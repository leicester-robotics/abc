<mujoco model="abc_box">
  <!--
    Task-independent ABC Box cell: floor, base cabinet + gate (visual mesh +
    collision boxes), side/back walls, table plane, top-mounted D405 camera and
    a few debug cameras. Geometry stripped from amazon-far/abc
    assets/put_bottles/put_bottle.xml (Apache-2.0). Arms are attached
    programmatically by gontrol_simulation.scene.
  -->
  <compiler angle="radian" meshdir="../yam/assets" texturedir="../yam/assets"/>

  <option integrator="implicitfast"/>
  <size nconmax="512" njmax="4096"/>

  <visual>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
    <quality shadowsize="8192" offsamples="16"/>
    <headlight ambient="0.40 0.40 0.40" diffuse="0.0 0.0 0.0" specular="0 0 0"/>
    <rgba haze="1.0 1.0 1.0 1"/>
  </visual>

  <asset>
    <mesh name="base_visual_gate" file="base_visual_gate.stl"/>
    <mesh name="top_camera_d405" file="d405.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.30 0.30 0.30" specular="0.05 0.05 0.05"/>

    <geom name="floor" size="0 0 0.05" type="plane" contype="0" conaffinity="0" rgba="0.75 0.75 0.75 1"/>
    <geom name="floor_collision" size="0 0 0.05" type="plane" group="3" rgba="0 0 0 0"/>

    <geom name="base_visual" type="mesh" contype="0" conaffinity="0" group="2" density="0"
      rgba="0.60 0.62 0.68 1" mesh="base_visual_gate"/>
    <geom name="base_collision" size="0.2975 0.65 0.375" pos="0 0 0.375" type="box" group="3" rgba="1 0 0 0.0"/>

    <body name="gate_collision" pos="0 0 0.75">
      <geom name="gate_post_left" size="0.015 0.015 0.45" pos="0 0.575 0.45" type="box" group="3" rgba="1 0 0 0.0"/>
      <geom name="gate_post_right" size="0.015 0.015 0.45" pos="0 -0.575 0.45" type="box" group="3" rgba="1 0 0 0.0"/>
      <geom name="gate_top_bar" size="0.015 0.015 0.59" pos="0 0 0.915" quat="0.707107 0.707107 0 0" type="box"
        group="3" rgba="1 0 0 0.0"/>
      <body name="top_bar_center" pos="0 0 0.915">
        <body name="top_camera_d405" pos="0.08600512 -0.009 0.03932053" quat="0.183012 0.683013 0.683013 0.183012">
          <geom type="mesh" contype="0" conaffinity="0" group="2" density="0.001" mass="0.001"
            rgba="0.22 0.22 0.24 1" mesh="top_camera_d405"/>
          <body name="top_camera_frame" pos="0.009 0 0" quat="0 0 0 1">
            <camera name="top" pos="0 0 0" quat="0 1 0 0" fovy="58"/>
          </body>
        </body>
      </body>
    </body>

    <geom name="back_wall" type="box" size="0.005 0.65 1.0" pos="0.9 0 1.0" group="2" contype="0" conaffinity="0"
      rgba="0.88 0.88 0.88 1"/>
    <geom name="back_wall_collision" type="box" size="0.005 0.65 1.0" pos="0.9 0 1.0" group="3" rgba="0 0 0 0"/>
    <geom name="left_wall" type="box" size="0.45 0.005 1.0" pos="0.45 0.65 1.0" group="2" contype="0" conaffinity="0"
      rgba="0.88 0.88 0.88 1"/>
    <geom name="left_wall_collision" type="box" size="0.45 0.005 1.0" pos="0.45 0.65 1.0" group="3" rgba="0 0 0 0"/>
    <geom name="right_wall" type="box" size="0.45 0.005 1.0" pos="0.45 -0.65 1.0" group="2" contype="0" conaffinity="0"
      rgba="0.88 0.88 0.88 1"/>
    <geom name="right_wall_collision" type="box" size="0.45 0.005 1.0" pos="0.45 -0.65 1.0" group="3" rgba="0 0 0 0"/>

    <body name="overhead_camera" pos="0.55 0.0 1.6">
      <camera name="overhead" pos="0 0 0" quat="0.707 0 0 -0.707" fovy="60"/>
    </body>
    <body name="left_side_camera" pos="0.5 0.55 1.05" euler="-1.3 0 3.14159">
      <camera name="left_side" pos="0 0 0" fovy="70"/>
    </body>
    <body name="right_side_camera" pos="0.5 -0.55 1.05" euler="1.3 0 0">
      <camera name="right_side" pos="0 0 0" fovy="70"/>
    </body>

    <!-- Front view: near the back wall, looking back at the arms. -->
    <camera name="front" pos="0.88 0 1.2" xyaxes="0 1 0 -0.342 0 0.94" fovy="75"/>

    <camera name="diag" pos="0.02 0.5 1.5" xyaxes="-0.687 -0.727 0 0.483 -0.457 0.746" fovy="55"/>
    <camera name="diag_right" pos="0.02 -0.5 1.5" xyaxes="0.687 -0.727 0 0.483 0.457 0.746" fovy="55"/>

    <body name="play_table">
      <geom name="table_visual" size="0.2975 0.65 0.005" pos="0.6 0 0.745" type="box" group="2" contype="0"
        conaffinity="0" rgba="0.92 0.92 0.92 1"/>
    </body>
    <geom name="table_plane" type="plane" size="0.2975 0.65 0.01" pos="0.6 0 0.75" rgba="0 0 0 0" group="3"/>
  </worldbody>
</mujoco>
